// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    }
  },
  {
    "bindings": {
      "cmd-k right": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }]
    }
  },
  {
    "bindings": {
      "cmd-k left": ["workspace::MoveItemToPaneInDirection", { "direction": "left" }]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-k cmd-left": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-k cmd-right": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-d": "editor::DuplicateLineDown"
    }
  }
]
