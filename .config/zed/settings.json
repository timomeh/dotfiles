// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "inline_code_actions": true,
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "double_click_in_multibuffer": "open",
  "soft_wrap": "none",
  "show_wrap_guides": true,
  "wrap_guides": [80],
  "server_url": "https://zed.dev",
  "proxy": "",
  "git": {
    "inline_blame": {
      "enabled": false,
      "min_column": 0,
      "show_commit_summary": false
    },
    "enable_diff": true,
    "enable_status": true
  },
  "bottom_dock_layout": "contained",
  "colorize_brackets": false,
  "inlay_hints": {
    "show_parameter_hints": true,
    "show_type_hints": true,
    "show_other_hints": true,
    "show_value_hints": true,
    "enabled": false
  },
  "completion_menu_item_kind": "symbol",
  "show_whitespaces": "boundary",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "line_width": 1,
    "active_line_width": 2
  },
  "vim": {
    "default_mode": "insert"
  },
  "minimap": {
    "max_width_columns": 80,
    "thumb_border": "right_open",
    "thumb": "always",
    "show": "auto"
  },
  "gutter": {
    "min_line_number_digits": 4,
    "folds": false
  },
  "relative_line_numbers": "enabled",
  "hover_popover_sticky": true,
  "auto_signature_help": false,
  "sticky_scroll": {
    "enabled": true
  },
  "scroll_beyond_last_line": "one_page",
  "unnecessary_code_fade": 0.5,
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "outline_panel": {
    "button": true,
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "git_panel": {
    "show_count_badge": false,
    "file_icons": false,
    "tree_view": false,
    "collapse_untracked_diff": false,
    "sort_by_path": false,
    "default_width": 420.0,
    "status_style": "icon",
    "dock": "right"
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": false
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.3-codex",
      "enable_thinking": true,
      "effort": "medium"
    },
    "sidebar_side": "right",
    "dock": "right",
    "model_parameters": [],
    "enable_feedback": true
  },
  "show_edit_predictions": false,
  "zoomed_padding": true,
  "use_system_window_tabs": false,
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_user_picture": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": true,
    "show_menus": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "inline": {
      "enabled": false
    },
    "button": true
  },
  "terminal": {
    "default_height": 480.0,
    "copy_on_select": true,
    "font_family": "FiraCode Nerd Font Mono",
    "font_weight": 300.0,
    "font_size": 13.0,
    "shell": {
      "program": "/opt/homebrew/bin/fish"
    },
    "show_count_badge": false,
    "button": true
  },
  "status_bar": {
    "show_active_file": true,
    "cursor_position_button": true,
    "active_language_button": true
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "git_status_indicator": true,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "hide_root": false,
    "hide_hidden": false,
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "indent_size": 17.0,
    "git_status": true,
    "folder_icons": false,
    "file_icons": true,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "default_width": 260.0,
    "dock": "left",
    "button": true
  },
  "rounded_selection": true,
  "vim_mode": true,
  "ui_font_family": ".ZedSans",
  "ui_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Dank Mono",
  "buffer_font_weight": 400.0,
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "buffer_font_features": {
    "calt": false // Disable ligatures
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night"
  },
  "file_scan_exclusions": ["**/.elixir_ls", "**/.expert"],

  //
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "hover": false
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "elixir": "html",
          "heex": "html"
        },
        "experimental": {
          "classRegex": ["class=\"([^\"]*)\"", "class='([^']*)'"]
        }
      }
    },
    "elixir-ls": {
      "settings": {
        "dialyzerEnabled": false
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server"],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Elixir": {
      "language_servers": [
        "expert",
        "tailwindcss-language-server",
        "!elixir-ls",
        "!dexter",
        "!next-ls",
        "!lexical",
        "..."
      ]
    },
    "EEx": {
      "language_servers": [
        "expert",
        "tailwindcss-language-server",
        "!elixir-ls",
        "!dexter",
        "!next-ls",
        "!lexical",
        "..."
      ]
    },
    "HEEx": {
      "language_servers": [
        "expert",
        "tailwindcss-language-server",
        "!elixir-ls",
        "!dexter",
        "!next-ls",
        "!lexical",
        "..."
      ]
    },
    "GraphQL": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Handlebars": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON5": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Less": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Markdown": {
      "format_on_save": "on",
      "soft_wrap": "bounded",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "MDX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
